# LLM API Key (统一环境变量名称，适用于所有 OpenAI 兼容的 API)
# Set this to your API key from any provider (OpenAI, DeepSeek, SiliconFlow, etc.)
# The actual provider is determined by base_url in config YAML
LLM_API_KEY=sk-your-api-key-here

# Docker / PostgreSQL password (used by docker-compose.yml)
# Copy this file to .env and set a strong password. Never commit .env to git.
POSTGRES_PASSWORD=change_me_use_a_strong_password
